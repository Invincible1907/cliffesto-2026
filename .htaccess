RewriteEngine On

# Recover from the server filesystem path that was exposed as a public URL.
RewriteRule ^var/www/html/web/?$ ./ [R=301,L]

# Redirect old page URLs to their clean equivalents.
RewriteCond %{THE_REQUEST} \s/+[^\s?]+/index\.html(?:[?\s]) [NC]
RewriteRule ^index\.html$ ./ [R=301,L]
RewriteCond %{THE_REQUEST} \s/+[^\s?]+/events/events\.html(?:[?\s]) [NC]
RewriteRule ^events/events\.html$ events/ [R=301,L]
RewriteCond %{THE_REQUEST} \s/+[^\s?]+/register/register\.html(?:[?\s]) [NC]
RewriteRule ^register/register\.html$ passes/ [R=301,L]
RewriteCond %{THE_REQUEST} \s/+[^\s?]+/contact/contact\.html(?:[?\s]) [NC]
RewriteRule ^contact/contact\.html$ contact/ [R=301,L]
RewriteCond %{THE_REQUEST} \s/+[^\s?]+/sponsor/sponsor\.html(?:[?\s]) [NC]
RewriteRule ^sponsor/sponsor\.html$ sponsor/ [R=301,L]
RewriteCond %{THE_REQUEST} \s/+[^\s?]+/past-events\.html(?:[?\s]) [NC]
RewriteRule ^past-events\.html$ gallery [R=301,L]
RewriteCond %{THE_REQUEST} \s/+[^\s?]+/events-cultural/events\.html(?:[?\s]) [NC]
RewriteRule ^events-cultural/events\.html$ events-cultural/ [R=301,L]
RewriteCond %{THE_REQUEST} \s/+[^\s?]+/events-literary/events\.html(?:[?\s]) [NC]
RewriteRule ^events-literary/events\.html$ events-literary/ [R=301,L]
RewriteCond %{THE_REQUEST} \s/+[^\s?]+/events-technical/events\.html(?:[?\s]) [NC]
RewriteRule ^events-technical/events\.html$ events-technical/ [R=301,L]

# Clean page URLs.
RewriteRule ^home/?$ index.html [L]
RewriteRule ^events/?$ events/events.html [L]
RewriteRule ^passes/?$ register/register.html [L]
RewriteRule ^contact/?$ contact/contact.html [L]
RewriteRule ^sponsor/?$ sponsor/sponsor.html [L]
RewriteRule ^gallery$ past-events.html [L]
RewriteRule ^events-cultural/?$ events-cultural/events.html [L]
RewriteRule ^events-literary/?$ events-literary/events.html [L]
RewriteRule ^events-technical/?$ events-technical/events.html [L]

# Keep other real files and directories working normally.
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]
